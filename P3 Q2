# Instanciando o modelo
model = Model(sense=MINIMIZE, solver_name=CBC)

# Variáveis de decisão: Quantidade de barras de 6m a serem cortadas segundo cada padrão
# x1: Padrão 1 (3 de 2m)
# x2: Padrão 2 (1 de 4m + 1 de 2m)
# x3: Padrão 3 (2 de 3m)
# x4: Padrão 4 (1 de 3m + 1 de 2m)
x1 = model.add_var(name="Padrao_3x2m", var_type=INTEGER)
x2 = model.add_var(name="Padrao_1x4m_1x2m", var_type=INTEGER)
x3 = model.add_var(name="Padrao_2x3m", var_type=INTEGER)
x4 = model.add_var(name="Padrao_1x3m_1x2m", var_type=INTEGER)

# Função Objetivo: Minimizar o total de barras de 6 metros utilizadas
model.objective = minimize(x1 + x2 + x3 + x4)

# Restrições de Demanda
# Demanda de 50 barras de 2 metros
model += 3*x1 + 1*x2 + 1*x4 >= 50, "demanda_2m"
# Demanda de 60 barras de 3 metros
model += 2*x3 + 1*x4 >= 60, "demanda_3m"
# Demanda de 90 barras de 4 metros
model += 1*x2 >= 90, "demanda_4m"
